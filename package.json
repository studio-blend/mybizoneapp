{
  "name": "mybizone",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "dotenv -e .env -- pnpm --filter @mybizone/web dev",
    "build": "dotenv -e .env -- pnpm -r build",
    "start": "dotenv -e .env -- pnpm --filter @mybizone/web start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "dotenv -e .env -- pnpm -r test",
    "test:e2e": "dotenv -e .env -- pnpm --filter @mybizone/web test:e2e",
    "db:generate": "dotenv -e .env -- pnpm --filter @mybizone/db generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @mybizone/db migrate",
    "db:push": "dotenv -e .env -- pnpm --filter @mybizone/db push",
    "db:studio": "dotenv -e .env -- pnpm --filter @mybizone/db studio",
    "db:seed": "dotenv -e .env -- pnpm --filter @mybizone/db seed",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down"
  },
  "pnpm": {
    "overrides": {
      "axios": "1.20.0",
      "postcss": "8.5.28",
      "@babel/core": "7.29.6",
      "@opentelemetry/core": "2.8.0",
      "baseline-browser-mapping": "2.11.0",
      "brace-expansion@<3": "2.1.4",
      "brace-expansion@>=3 <5.0.9": "5.0.9",
      "browserslist": "4.28.7",
      "fast-uri": "3.1.6",
      "fflate@<0.5": "0.4.9",
      "fflate@>=0.5 <0.8.3": "0.8.3",
      "js-cookie": "3.0.7",
      "vite": "6.4.3",
      "better-call>zod": "4.6.5"
    }
  },
  "devDependencies": {
    "vite": "6.4.3",
    "@biomejs/biome": "1.9.4",
    "dotenv-cli": "7.4.2",
    "typescript": "5.6.3"
  }
}
