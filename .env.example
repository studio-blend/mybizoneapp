# Postgres (local Docker dev: see docker-compose.yml)
DATABASE_URL=postgres://mybizone:mybizone@localhost:5432/mybizone

# Better Auth
BETTER_AUTH_SECRET=replace-with-`openssl rand -base64 32`
BETTER_AUTH_URL=http://localhost:3000

# Email (Resend) — leave blank in dev to log emails to console
RESEND_API_KEY=
EMAIL_FROM=MyBizOne <noreply@mybizone.local>

# Sentry — leave blank to disable
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# PostHog — leave blank to disable
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Storage backend: 'local' | 'r2' (M2)
STORAGE_BACKEND=local
# Absolute path for STORAGE_BACKEND=local (Docker mounts a volume here in prod self-host).
STORAGE_DIR=./storage
# R2 bucket name when STORAGE_BACKEND=r2 (M3+)
R2_BUCKET=

# LAN mode: skip HTTPS, use non-Secure cookies (for self-hosted shops on local network)
LAN_MODE=false

# Node env
NODE_ENV=development
