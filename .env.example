# Copy this to .env.local for local development
# Required
DATABASE_URL=postgresql://user:password@localhost:5432/mybizone
BETTER_AUTH_SECRET=your-32-char-secret-here-change-this
BETTER_AUTH_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=re_xxxx
EMAIL_FROM=MyBizOne <noreply@yourdomain.com>

# Razorpay (leave blank to disable billing)
RAZORPAY_KEY_ID=rzp_test_xxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx
RAZORPAY_WEBHOOK_SECRET=xxxx
RAZORPAY_PLAN_ID_MONTHLY=plan_xxxx
RAZORPAY_PLAN_ID_ANNUAL=plan_xxxx

# Sentry (leave blank to disable)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

NEXT_PUBLIC_SUPPORT_WHATSAPP=919999999999
LAN_MODE=false

# GSTN e-invoice API
GSTN_USERNAME=
GSTN_CLIENT_ID=
GSTN_CLIENT_SECRET=
GSTN_SANDBOX=true

# MSG91 SMS (optional)
MSG91_API_KEY=
MSG91_TEMPLATE_ID=
