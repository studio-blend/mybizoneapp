# Postgres (local Docker dev: see docker-compose.yml)
DATABASE_URL=postgres://mybizone:mybizone@localhost:5432/mybizone

# Better Auth
BETTER_AUTH_SECRET=replace-with-`openssl rand -base64 32`
BETTER_AUTH_URL=http://localhost:3000

# Email (Resend) — leave blank in dev to log emails to console
RESEND_API_KEY=
EMAIL_FROM=MyBizOne <noreply@mybizone.local>

# Sentry — leave blank to disable
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# PostHog — leave blank to disable
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Storage backend: 'local' | 'r2' (M2)
STORAGE_BACKEND=local

# Node env
NODE_ENV=development
